container_commands:
  01_remove_old_cron:
    command: "rm -f /etc/cron.d/update_docker_compose.bak"
  02_create_cron_file:
    command: |
      echo "*/15 * * * * root /usr/local/bin/update_docker_compose.sh" > /etc/cron.d/update_docker_compose
    owner: root
    group: root
    mode: "000644"

files:
  "/usr/local/bin/update_docker_compose.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      cd /var/app/current
      
      BASE_IMAGE=$(grep FROM Dockerfile | awk '{print $2}')

      docker pull "$BASE_IMAGE" | grep -q "Image is up to date" && exit 0
      
      CONTAINER_ID=$(docker ps --format "{{.ID}}")
      CONTAINER_NAME=$(docker ps --format "{{.Names}}")
      
      CONFIG=$(docker inspect $CONTAINER_ID)

      # Extract necessary settings from the configuration
      IMAGE=$(echo $CONFIG | jq -r '.[0].Config.Image')
      PORTS=$(echo $CONFIG | jq -r '.[0].HostConfig.PortBindings | to_entries[] | "--publish \(.key):\(.value[0].HostPort)"')
      VOLUMES=$(echo $CONFIG | jq -r '.[0].Mounts[] | "--volume \(.Source):\(.Destination)"')
      ENV_VARS=$(echo $CONFIG | jq -r '.[0].Config.Env[] | "--env \(.)"')

      # Stop and remove the container
      docker stop $CONTAINER_ID
      docker rm $CONTAINER_ID

      # Build a new image
      docker build . -t "$IMAGE"

      # Run a new container with the same settings
      docker run -d --name $CONTAINER_NAME $PORTS $VOLUMES $ENV_VARS $IMAGE

