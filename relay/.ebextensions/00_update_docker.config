files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/update_docker_compose.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Navigate to the directory containing the docker-compose.yml file
      cd /var/app/current
      
      # Pull the latest image
      docker compose pull
      
      # Get the image ID of the currently running container
      CURRENT_IMAGE_ID=$(docker inspect --format='{{.Image}}' $(docker ps -q --filter "name=relay"))

      # Get the image ID of the latest image
      LATEST_IMAGE_ID=$(docker inspect --format='{{.Id}}' ltonetwork/relay:latest)

      # Compare the image IDs
      if [ "$CURRENT_IMAGE_ID" != "$LATEST_IMAGE_ID" ]; then
        # Restart the container with the latest image
        docker compose down
        docker compose up -d
      fi

  "/opt/elasticbeanstalk/hooks/appdeploy/post/cron-job.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Write out current crontab
      crontab -l > mycron

      # Echo new cron into cron file (runs every 15 minutes)
      echo "*/15 * * * * /opt/elasticbeanstalk/hooks/appdeploy/post/update_docker_compose.sh" >> mycron

      # Install new cron file
      crontab mycron
      rm mycron

commands:
  00-update-docker-cron-job:
    command: "bash /opt/elasticbeanstalk/hooks/appdeploy/post/cron-job.sh"

